{
  // The domain layer must compile and run without a DOM: no `lib.dom`, no React,
  // no storage. `pnpm typecheck:domain` turns that rule into a build failure
  // instead of a code-review checklist item.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["vitest/globals"],
    "jsx": "preserve"
  },
  "include": ["src/domain"]
}
